# -----------------------------------------------------------------------------
# 加群审核机器人 - 生产环境配置模板
# -----------------------------------------------------------------------------
# 使用方式：
#   1. 复制此文件为 .env.prod：cp .env.prod.example .env.prod
#   2. 将各配置项的值替换为你的真实信息
#   3. .env.prod 会被 .gitignore 忽略，不会被提交到 Git
#
# 详细说明请参考 README.md
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# NoneBot 基础配置
# -----------------------------------------------------------------------------

DRIVER=~httpx+~websockets
LOG_LEVEL=INFO
# 本地日志目录；日志按天写入，不会自动上传或清理
LOCAL_LOG_DIRECTORY=logs
NICKNAME=["群管"]
COMMAND_START=["/", ""]
COMMAND_SEP=["."]

# -----------------------------------------------------------------------------
# 机器人管理员
# -----------------------------------------------------------------------------
# 所有管理指令都只会对「管理员私聊」响应，群聊中不会回复。
# SUPERUSERS    : 超级管理员，可执行所有命令，会收到异常加群事件通知
# ADMIN_QQS     : 普通管理员，可执行常规管理命令（不可操作 B 站 Cookie）
# NOTIFY_ADMINS_ON_ABNORMAL_REQUEST:
#   all             = 通知 SUPERUSERS + ADMIN_QQS
#   superusers_only = 仅通知 SUPERUSERS（默认）
#   none            = 不通知任何人

SUPERUSERS=["你的QQ号1","你的QQ号2"]
ADMIN_QQS="你的QQ号1,你的QQ号2"
NOTIFY_ADMINS_ON_ABNORMAL_REQUEST=superusers_only

# -----------------------------------------------------------------------------
# NapCat / OneBot 连接配置
# -----------------------------------------------------------------------------
# ONEBOT_WS_URLS      : NapCat 的 OneBot WebSocket 地址
# ONEBOT_ACCESS_TOKEN : NapCat 中配置的访问令牌

ONEBOT_WS_URLS=["ws://127.0.0.1:3001/onebot/v11/ws"]
ONEBOT_ACCESS_TOKEN=replace-with-a-random-onebot-token

# -----------------------------------------------------------------------------
# 群审核配置
# -----------------------------------------------------------------------------
# 各项参数含义及用法详见 README.md
#
# 推荐方式：只在 .env.prod 里填写群配置入口
# - groups.yaml 里放群基础参数、自定义拒绝名单，并通过 review_pipeline_file 字段引用审核流转文件
# - review_pipeline.yaml 里放审核分组流转
# - 两个 YAML 文件不含敏感信息，可直接提交至 Git
# - GROUP_REVIEW_PIPELINE_FILE 仅在使用 GROUP_ID / GROUP_N_ID 扁平配置时直接指定
GROUP_CONFIG_FILE=groups.yaml
# GROUP_REVIEW_PIPELINE_FILE=review_pipeline.yaml
# 如需快速覆盖 groups.yaml 中的某些字段，仍可继续使用下面这些环境变量：
# GROUP_ID=123456789
# GROUP_ENABLED=false
# GROUP_REQUIRED_QQ_LEVEL=0
# GROUP_REQUIRED_BILI_LEVEL=2
# GROUP_TARGET_UIDS=
# GROUP_TARGET_MEDAL_UIDS=
# GROUP_REQUIRED_MEDAL_LEVEL=0
# GROUP_REJECT_REASON_WITH_LEAVE_TIME=false
# GROUP_REVIEW_PIPELINE_FILE=review_pipeline.yaml
# GROUP_CUSTOM_REJECT_UIDS={"123456":"疑似主播本人ID","654321":"已知违规用户"}

# -----------------------------------------------------------------------------
# CookieCloud 配置（推荐使用，自动同步 B 站 Cookie）
# -----------------------------------------------------------------------------
# CookieCloud 可以将你浏览器的 B 站 Cookie 自动同步到服务器。
# 只需要在浏览器中安装 CookieCloud 插件并配置好下面三项即可。
# 不使用 CookieCloud 则保持为空。

COOKIECLOUD_HOST="https://cookiecloud.example.com"
COOKIECLOUD_UUID="replace-with-cookiecloud-uuid"
COOKIECLOUD_KEY="replace-with-cookiecloud-key"

# -----------------------------------------------------------------------------
# B 站 Cookie（手动填写，或使用 /设置cookie 私聊命令）
# -----------------------------------------------------------------------------

BILI_COOKIE=""

# 日志仅保存在本地。程序不会上传或自动清理日志；磁盘空间不足时通知 SUPERUSERS。

# -----------------------------------------------------------------------------
# 审核流程 WebUI（默认关闭；对外监听时务必使用强随机 Token）
# -----------------------------------------------------------------------------
WEBUI_ENABLED=false
WEBUI_HOST=127.0.0.1
WEBUI_PORT=1128
WEBUI_TOKEN=""
# 可选：自定义 WebUI 样式文件，相对路径以项目根目录为基准
WEBUI_CUSTOM_CSS_FILE=""
# WebUI 只允许回环地址；公网部署由同机可信反向代理提供 HTTPS，并将以下两项设为 true
WEBUI_REQUIRE_HTTPS=false
WEBUI_TRUST_PROXY_HEADERS=false
WEBUI_SESSION_TIMEOUT_SECONDS=3600
WEBUI_LOGIN_MAX_ATTEMPTS=5
WEBUI_LOGIN_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# B站 Cookie 有效性监控
# -----------------------------------------------------------------------------
# 定时检查 B站 Cookie 是否有效，过期或检查异常时通过邮件通知。
# 磁盘空间不足告警也会复用同一套邮件配置。
# COOKIE_CHECK_INTERVAL_SECONDS : 检查周期（秒），默认 3600（1小时）
#   最小 60 秒，最大 86400 秒（24小时）

COOKIE_CHECK_INTERVAL_SECONDS=3600

# -----------------------------------------------------------------------------
# 邮件通知配置（Cookie 异常与磁盘告警）
# -----------------------------------------------------------------------------
# SMTP 配置通过环境变量传入，部署时从全局 mail_config.json 映射。
# 不要将真实密码或授权码写入仓库文件。
#
# 配置方式（以 Linux/macOS 为例）：
#   export NOTIFY_SMTP_HOST="smtp.163.com"
#   export NOTIFY_SMTP_PORT="465"
#   export NOTIFY_SMTP_USER="your-email@163.com"
#   export NOTIFY_SMTP_PASSWORD="your-auth-code"
#   export NOTIFY_FROM_ADDR="your-email@163.com"
#   export NOTIFY_TO_ADDR="recipient@qq.com"
#
# 或在 .env.prod 中填写（此文件已被 .gitignore 忽略）：

NOTIFY_SMTP_HOST=""
NOTIFY_SMTP_PORT="465"
NOTIFY_SMTP_USER=""
NOTIFY_SMTP_PASSWORD=""
NOTIFY_FROM_ADDR=""
NOTIFY_TO_ADDR=""
