# Standalone FastAPI + OneBot. Copy to ignored .env.prod.
# .env -> .env.<ENVIRONMENT> -> process environment; process values win.
# Existing installations: preserve every old source for first SQLite migration.

# Infrastructure, read on every process start.
HOST=127.0.0.1
PORT=1128
LOG_LEVEL=INFO
LOCAL_LOG_DIRECTORY=logs
SUPERUSERS=["replace-with-your-qq"]
ONEBOT_WS_URLS=["ws://127.0.0.1:3001/"]
ONEBOT_ACCESS_TOKEN=replace-with-a-random-onebot-token
# For reverse WS, set ONEBOT_WS_URLS=[] and connect SnowLuma to:
# ws://127.0.0.1:1128/onebot/v11/ws (Bearer token / X-Self-ID required).
ONEBOT_ACTION_TIMEOUT=30
ONEBOT_EVENT_WORKERS=4
ONEBOT_EVENT_QUEUE_SIZE=256
DECISION_RECONCILE_INTERVAL=30
BILI_REQUESTS_PER_SECOND=2
BILI_OBSERVATION_TTL=60
COMMAND_START=["/", ""]
COMMAND_SEP=["."]

# The following business values seed SQLite ONLY on the first migration.
# Once a config revision exists, edit the admin console/SQL config, not this file.
# All legacy GROUP_ID/GROUP_N_*, JSON and YAML sources are imported with their
# original effective precedence once. New installations use the groups example
# as an initial seed, then manage groups and pipelines in the console.
GROUP_CONFIG_FILE=groups.yaml
ADMIN_QQS=""
NOTIFY_ADMINS_ON_ABNORMAL_REQUEST=superusers_only
BILI_COOKIE=""
BILI_REFRESH_TOKEN=""
COOKIECLOUD_HOST=""
COOKIECLOUD_UUID=""
COOKIECLOUD_KEY=""
COOKIE_CHECK_INTERVAL_SECONDS=3600

# Admin console shares PORT. Keep loopback; use a trusted same-host HTTPS proxy.
# Web security fields are SQL business settings after first initialization.
WEBUI_ENABLED=false
WEBUI_HOST=127.0.0.1
WEBUI_PORT=1128
WEBUI_TOKEN=""
WEBUI_REQUIRE_HTTPS=false
WEBUI_TRUST_PROXY_HEADERS=false
WEBUI_CUSTOM_CSS_FILE=""
WEBUI_SESSION_TIMEOUT_SECONDS=3600
WEBUI_LOGIN_MAX_ATTEMPTS=5
WEBUI_LOGIN_WINDOW_SECONDS=900

# SMTP is migrated to private SQL config. Password is hidden in public exports.
# .env.prod values are loaded and published to the process by app.settings.
NOTIFY_SMTP_HOST=""
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_USER=""
NOTIFY_SMTP_PASSWORD=""
NOTIFY_FROM_ADDR=""
NOTIFY_TO_ADDR=""

# Ownership and patrol are disabled by default. Configure per-group verification
# and patrol in the console. Examples and migration/rollback: docs/configuration.md.
# After SQL4 migration, old src.plugins implementation must not open this DB.
